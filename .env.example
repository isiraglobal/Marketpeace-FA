# ============================================================
# MARKETPEACE — Environment Variables Template
# ============================================================
# Copy this file to `.env.local` and fill in your values.
# NEVER commit .env.local or any .env* file to git.
# All these values MUST be set in your Vercel dashboard for production.
# ============================================================

# --- Stripe ---
# Your Stripe secret key (starts with sk_live_ for production, sk_test_ for testing)
# NEVER use sk_live_ in development or expose this anywhere client-side
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe webhook signing secret (from Stripe Dashboard → Webhooks → Signing Secret)
# Required for CRIT-1: webhook signature verification
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Google Apps Script ---
# The deployment URL of your Google Apps Script web app
# Keep this server-side ONLY — never expose to the browser
# Format: https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzMy704WpClMl5LKGMS_HY6Onl8p1Eh8gZhuzRmjnVrZQONROYUbB2acYL38quKLjqoKg/exec

# --- Internal Security ---
# A strong random secret shared between your API handlers and the Apps Script
# This prevents unauthorized calls to the Apps Script updateStatus endpoint
# Generate with: openssl rand -base64 32
INTERNAL_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# --- Notion (Optional) ---
# Only needed if using Notion integration
NOTION_API_KEY=secret_REPLACE_ME
NOTION_DATABASE_ID=REPLACE_ME

# --- Discord Notifications ---
# Webhook URL for real-time Discord alerts (new signups, payments, errors)
# Set this as DISCORD_WEBHOOK_URL in Google Apps Script Properties
# Example: https://discord.com/api/webhooks/CHANNEL_ID/TOKEN
# DISCORD_WEBHOOK_URL=

# --- NVIDIA NIM AI ---
# API key for NVIDIA NIM (used in Google Apps Script for AI offer generation)
# This key is stored in Apps Script Script Properties, not in Vercel env.
# It powers the custom vendor offer generation pipeline.
NVIDIA_NIM_API_KEY=nvapi-REPLACE_ME

# --- Note on Apps Script Properties ---
# The following are configured as Script Properties in Google Apps Script,
# not as Vercel environment variables:
#   - DISCORD_WEBHOOK_URL: Discord webhook for notifications
#   - NVIDIA_NIM_API_KEY: NVIDIA NIM API key for AI offer generation
#   - STRIPE_SECRET_KEY: Stripe secret key for creating Payment Links
#   - INTERNAL_SECRET: Shared secret for request authentication
#   - VENUE_WEBHOOK_URL: Webhook URL for venue sync
# After redeploying the Apps Script, run `setupSheets` then `setupTriggers` once
# to create both cron jobs (AI offers ~10m, offer follow-ups ~6h).
